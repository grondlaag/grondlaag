---
import { getCollection, getEntry, render } from 'astro:content';
import ServiceCard from '../../components/ServiceCard.astro';
import Layout from '../../layouts/Layout.astro';
import { getExcerpt, sortByManualOrder } from '../../utils/content';
import { withBase } from '../../utils/routes';

const page = await getEntry('paginas', 'advies');
if (!page) {
	throw new Error('Pagina content ontbreekt: src/content/paginas/advies.md');
}

const { Content } = await render(page);
const adviceItems = sortByManualOrder(await getCollection('advies'));
---

<Layout title={`${page.data.title} | grondlaag`} description={page.data.description}>
	<main class="listing-page container">
		<header class="listing-header">
			<h1>{page.data.title}</h1>
			<div class="listing-intro">
				<Content />
			</div>
		</header>

		<div class="service-grid">
			{adviceItems.map((item) => (
				<ServiceCard
					title={item.data.title}
					description={getExcerpt(item.body, item.data.description)}
					href={withBase(`advies/${item.id}/`)}
					meta={item.data.price}
					category={item.data.category}
					accent={item.data.accent}
				/>
			))}
		</div>
	</main>
</Layout>
