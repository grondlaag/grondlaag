---
import { getCollection, render } from 'astro:content';
import CatalogueDetail from '../../components/CatalogueDetail.astro';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const opleidingen = await getCollection('opleidingen');

	return opleidingen.map((opleiding) => ({
		params: { slug: opleiding.id },
		props: { opleiding },
	}));
}

const { opleiding } = Astro.props;
const { Content } = await render(opleiding);
---

<Layout title={`${opleiding.data.title} | grondlaag`} description={opleiding.data.description}>
	<CatalogueDetail
		title={opleiding.data.title}
		description={opleiding.data.description}
		eyebrow="opleidingen"
		date={opleiding.data.date}
		meta={[
			{ label: 'status', value: opleiding.data.status },
			{ label: 'prijs', value: opleiding.data.price },
			{ label: 'duur', value: opleiding.data.duur },
		]}
		ctas={[
			{ label: opleiding.data.cta_label, href: opleiding.data.cta_link },
		]}
	>
		<Content />
	</CatalogueDetail>
</Layout>
