---
import { getCollection, getEntry, render } from 'astro:content';
import ServiceCard from '../../components/ServiceCard.astro';
import Layout from '../../layouts/Layout.astro';
import { getStatusPresentation } from '../../utils/catalogue';
import { getExcerpt, sortByManualOrder } from '../../utils/content';
import { withBase } from '../../utils/routes';

const page = await getEntry('paginas', 'opleidingen');
if (!page) {
	throw new Error('Pagina content ontbreekt: src/content/paginas/opleidingen.md');
}

const { Content } = await render(page);
const opleidingen = sortByManualOrder(await getCollection('opleidingen'));
---

<Layout
	title={`${page.data.title} | grondlaag`}
	description={page.data.description}
>
	<main class="listing-page container">
		<header class="listing-header">
			<h1>{page.data.title}</h1>
			<div class="listing-intro">
				<Content />
			</div>
		</header>

		<div class="service-grid">
			{opleidingen.map((opleiding) => {
				const status = getStatusPresentation(opleiding.data.status);

				return (
					<ServiceCard
						title={opleiding.data.title}
						description={getExcerpt(opleiding.body, opleiding.data.description)}
						href={withBase(`opleidingen/${opleiding.id}/`)}
						meta={opleiding.data.price}
						category={opleiding.data.category}
						status={status?.label}
						statusTone={status?.tone}
						accent={opleiding.data.accent}
					/>
				);
			})}
		</div>
	</main>
</Layout>
