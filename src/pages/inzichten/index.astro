---
import { getCollection, getEntry, render } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import Layout from '../../layouts/Layout.astro';
import { getExcerpt } from '../../utils/content';
import { withBase } from '../../utils/routes';

const page = await getEntry('paginas', 'notities');
if (!page) {
	throw new Error('Pagina content ontbreekt: src/content/paginas/notities.md');
}

const { Content } = await render(page);
const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout title={`${page.data.title} | grondlaag`} description={page.data.description}>
	<main class="listing-page container">
		<header class="listing-header">
			{page.data.eyebrow && <p class="eyebrow">{page.data.eyebrow}</p>}
			<h1>{page.data.title}</h1>
			<div class="listing-intro">
				<Content />
			</div>
		</header>

		<div class="article-listing">
			{posts.map((post) => (
				<ArticleCard
					title={post.data.title}
					description={getExcerpt(post.body, post.data.description)}
					href={withBase(`inzichten/${post.id}/`)}
					date={post.data.date}
				/>
			))}
		</div>
	</main>
</Layout>
