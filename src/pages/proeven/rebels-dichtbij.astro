---
import HomepageContent from '../../components/HomepageContent.astro';
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../utils/routes';
---

<!-- previewroute: variant die de subtiel rebels-taal behoudt maar dichter tegen het origineel aanleunt -->
<Layout
	title="rebels dichtbij | grondlaag"
	description="preview van een rebelse variant die nog dicht bij het origineel blijft."
	theme="rebels-dichtbij"
>
	<div class="preview-banner container">
		<p>preview theme: rebels dichtbij</p>
		<p>
			<a href={withBase('proeven/rebels-onredelijk')}>onredelijk</a>
			<a href={withBase('proeven/rebels-clever')}>clever CSS</a>
			<a href={withBase()}>origineel</a>
		</p>
	</div>
	<HomepageContent />
</Layout>
