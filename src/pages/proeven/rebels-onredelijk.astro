---
import HomepageContent from '../../components/HomepageContent.astro';
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../utils/routes';
---

<!-- previewroute: opzettelijk overdreven, brutalistischer en meer archigram-achtig -->
<Layout
	title="rebels onredelijk | grondlaag"
	description="preview van een onredelijke, uitgesproken brutale variant voor grondlaag."
	theme="rebels-onredelijk"
>
	<div class="preview-banner container">
		<p>preview theme: rebels onredelijk</p>
		<p>
			<a href={withBase('proeven/rebels-dichtbij')}>dichtbij origineel</a>
			<a href={withBase('proeven/rebels-clever')}>clever CSS</a>
			<a href={withBase()}>origineel</a>
		</p>
	</div>
	<HomepageContent />
</Layout>
