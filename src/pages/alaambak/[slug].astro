---
import { getCollection, render } from 'astro:content';
import CatalogueDetail from '../../components/CatalogueDetail.astro';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const items = await getCollection('alaambak');

	return items.map((item) => ({
		params: { slug: item.id },
		props: { item },
	}));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<Layout title={`${item.data.title} | grondlaag`} description={item.data.description}>
	<CatalogueDetail
		title={item.data.title}
		description={item.data.description}
		eyebrow="alaambak"
		date={item.data.date}
		meta={[
			{ label: 'status', value: item.data.status },
			{ label: 'prijs', value: item.data.price },
		]}
		ctas={[
			{ label: item.data.cta_label, href: item.data.cta_link },
			{ label: item.data.secondary_cta_label, href: item.data.secondary_cta_link, variant: 'secondary' },
		]}
	>
		<Content />
	</CatalogueDetail>
</Layout>
