---
import { getCollection, getEntry, render } from 'astro:content';
import ServiceCard from '../../components/ServiceCard.astro';
import Layout from '../../layouts/Layout.astro';
import { getExcerpt, sortByManualOrder } from '../../utils/content';

const page = await getEntry('paginas', 'alaambak');
if (!page) {
	throw new Error('Pagina content ontbreekt: src/content/paginas/alaambak.md');
}

const { Content } = await render(page);
const items = sortByManualOrder(await getCollection('alaambak'));

function getStatusPresentation(status?: string) {
	switch (status?.toLowerCase()) {
		case 'beschikbaar':
			return { label: 'beschikbaar', tone: 'available' as const };
		case 'volzet':
			return { label: 'volzet', tone: 'full' as const };
		case 'voorzien':
		case 'binnenkort':
		case 'in opbouw':
			return { label: 'binnenkort', tone: 'soon' as const };
		default:
			return undefined;
	}
}
---

<Layout title={`${page.data.title} | grondlaag`} description={page.data.description}>
	<main class="listing-page container">
		<header class="listing-header">
			<h1>{page.data.title}</h1>
			<div class="listing-intro">
				<Content />
			</div>
		</header>

		<div class="service-grid">
			{items.map((item) => {
				const status = getStatusPresentation(item.data.status);

				return (
					<ServiceCard
						title={item.data.title}
						description={getExcerpt(item.body, item.data.description)}
						href={`/grondlaag/alaambak/${item.id}/`}
						meta={item.data.price}
						category={item.data.category}
						status={status?.label}
						statusTone={status?.tone}
						accent={item.data.accent}
					/>
				);
			})}
		</div>
	</main>
</Layout>
