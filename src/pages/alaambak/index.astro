---
import { getCollection, getEntry, render } from 'astro:content';
import ServiceCard from '../../components/ServiceCard.astro';
import Layout from '../../layouts/Layout.astro';
import { getStatusPresentation } from '../../utils/catalogue';
import { getExcerpt, sortByManualOrder } from '../../utils/content';
import { withBase } from '../../utils/routes';

const page = await getEntry('paginas', 'alaambak');
if (!page) {
	throw new Error('Pagina content ontbreekt: src/content/paginas/alaambak.md');
}

const { Content } = await render(page);
const items = sortByManualOrder(await getCollection('alaambak'));
---

<Layout title={`${page.data.title} | grondlaag`} description={page.data.description}>
	<main class="listing-page container">
		<header class="listing-header">
			<h1>{page.data.title}</h1>
			<div class="listing-intro">
				<Content />
			</div>
		</header>

		<div class="service-grid">
			{items.map((item) => {
				const status = getStatusPresentation(item.data.status);

				return (
					<ServiceCard
						title={item.data.title}
						description={getExcerpt(item.body, item.data.description)}
						href={withBase(`alaambak/${item.id}/`)}
						meta={item.data.price}
						category={item.data.category}
						status={status?.label}
						statusTone={status?.tone}
						accent={item.data.accent}
					/>
				);
			})}
		</div>
	</main>
</Layout>
