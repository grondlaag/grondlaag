---
import { withBase } from '../utils/routes';

interface Props {
	title: string;
	subtitle: string;
	text: string;
	textSecond: string;
	ctaHref: string;
	ctaLabel: string;
	secondaryCtaHref?: string;
	secondaryCtaLabel?: string;
}

const { title, subtitle, text, textSecond, ctaHref, ctaLabel, secondaryCtaHref, secondaryCtaLabel } = Astro.props;
---

<section class="hero">
	<div class="hero__inner container">
		<div class="hero__content">
			<p class="eyebrow">{subtitle}</p>
			<h1>{title}</h1>
			<p class="hero__text">{text}</p>
			<p class="hero__text">{textSecond}</p>
			<div class="hero__actions">
				<a class="button" href={ctaHref}>{ctaLabel}</a>
				{secondaryCtaHref && secondaryCtaLabel && (
					<a class="button button--secondary" href={secondaryCtaHref}>{secondaryCtaLabel}</a>
				)}
			</div>
		</div>
		<figure class="hero__media">
			<img
				src={withBase('grondlaag-banner.png')}
				alt="architectuuratelier met digitale structuur op de werktafel"
				loading="eager"
				decoding="async"
				fetchpriority="high"
			/>
		</figure>
	</div>
</section>
