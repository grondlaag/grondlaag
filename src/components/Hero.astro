---
interface Props {
	title: string;
	subtitle: string;
	text: string;
	textSecond: String;
	ctaHref: string;
	ctaLabel: string;
	secondaryCtaHref?: string;
	secondaryCtaLabel?: string;
}

const { title, subtitle, text, textSecond, ctaHref, ctaLabel, secondaryCtaHref, secondaryCtaLabel } = Astro.props;
---

<section class="hero">
	<div class="hero__inner container">
		<div class="hero__content">
			<p class="eyebrow">{subtitle}</p>
			<h1>{title}</h1>
			<p class="hero__text">{text}</p>
			<p class="hero__text">{textSecond}</p>
			<div class="hero__actions">
				<a class="button" href={ctaHref}>{ctaLabel}</a>
				{secondaryCtaHref && secondaryCtaLabel && (
					<a class="button button--secondary" href={secondaryCtaHref}>{secondaryCtaLabel}</a>
				)}
			</div>
		</div>
		<figure class="hero__media" aria-label="architectuuratelier met digitale assistenten aan tekentafels">
			<img src="/grondlaag/grondlaag-banner.png" alt="" loading="eager" decoding="async" />
		</figure>
	</div>
</section>
