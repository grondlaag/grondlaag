---
import { getCollection } from 'astro:content';
import ArticleCard from './ArticleCard.astro';
import Hero from './Hero.astro';
import PillarCard from './PillarCard.astro';
import Section from './Section.astro';

const pillars = [
	{
		title: '1. advies',
		description: 'gerichte hulp bij digitale knopen: mappenstructuren, modelafspraken, besteklogica, informatiebeheer, toolkeuzes en vastgelopen workflows.',
		href: '/grondlaag/advies',
	},
	{
		title: '2. opleidingen',
		description: 'praktische sessies voor ontwerpteams die beter willen samenwerken met modellen, documenten, data en afspraken die ook na de opleiding bruikbaar blijven.',
		href: '/grondlaag/opleidingen',
	},
	{
		title: '3. alaambak',
		description: 'geen platform, geen dashboard, geen belofte van totale controle. wel formats, checks en kleine tools die een concreet probleem oplossen.',
		href: '/grondlaag/alaambak',
	},
];

const latestPosts = (await getCollection('posts'))
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 3);
---

<main>
	<Hero
		title="grondlaag"
		subtitle="digitale structuur voor architecten en ontwerpteams"
		text="grondlaag helpt kleine en middelgrote architecten- en ontwerpteams om digitale werkprocessen leesbaar, overdraagbaar en bruikbaar te maken."
		textSecond="niet door er nog een zwaar systeem bovenop te zetten, maar door de onderlaag helder te krijgen: afspraken, informatie, mappen, modellen, documenten en kleine tools."
		ctaHref="mailto:grondlaag@proton.me"
		ctaLabel="grondlaag@proton.me"
		secondaryCtaHref="https://cal.eu/grondlaag/snelle-babbel"
		secondaryCtaLabel="boek een snelle babbel"
	/>

	<Section
		id="probleem"
		title="waar het vaak vastloopt"
	>
		<div class="problem-text">
			<p>
				in veel ontwerpteams ontstaan digitale problemen niet door een gebrek aan inzet,
				maar door een gebrek aan gedeelde structuur. bestanden krijgen verschillende logica's,
				modellen groeien volgens projectdruk, afspraken zitten verspreid in mails en kennis blijft te vaak in hoofden hangen.
			</p>

			<p>
				daardoor wordt samenwerken moeilijker dan nodig: informatie is moeilijk terug te vinden,
				beslissingen zijn slecht traceerbaar, modellen worden broos en kleine fouten keren telkens terug.
				grondlaag vertrekt vanuit die dagelijkse frictie.
			</p>
		</div>
	</Section>

	<Section
		id="aanpak"
		title="eerst de grondlaag"
	>
		<div class="problem-text">
			<p>
				grondlaag vertrekt niet vanuit één softwarepakket of één vaste methode.
				de vraag is eerst: welke informatie moet betrouwbaar blijven,
				wie moet ermee werken en op welk moment in het project moet ze bruikbaar zijn?
			</p>

			<p>
				pas daarna komen mappenstructuren, modelafspraken, besteklogica, spreadsheets,
				markdownbestanden, kleine webtools of automatisering in beeld.
				de tool volgt de structuur, niet omgekeerd.

				concreet kan dat betekenen dat we een team helpen om van zeven verschillende mappenstructuren naar één herkenbare projectstructuur te gaan. 
				of dat we BIM-afspraken, besteknummers en meetstaatlogica beter op elkaar afstemmen, zodat informatie niet telkens opnieuw geïnterpreteerd moet worden.
			</p>

		</div>
	</Section>

	<Section
		id="pijlers"
		title="hoe we hier op ingrijpen"
		intro="grondlaag werkt op drie niveaus: directe hulp wanneer een project vastloopt, opleiding zodat teams zelf sterker worden, en kleine hulpmiddelen die structuur tastbaar maken."
	>
		<div class="pillar-grid">
			{pillars.map((pillar) => <PillarCard {...pillar} />)}
		</div>
	</Section>

	<Section
		id="artikels"
		title="notities uit de praktijk"
		intro="korte teksten over digitale structuur, samenwerking, BIM, bestekken, kleine tools en de dagelijkse frictie tussen ontwerpwerk en software."
	>
		<div class="article-teaser-list">
			{latestPosts.map((post) => (
				<ArticleCard
					title={post.data.title}
					description={post.data.description}
					href={`/grondlaag/inzichten/${post.id}/`}
					date={post.data.date}
				/>
			))}
		</div>
		<p class="section-link">
			<a href="/grondlaag/inzichten">bekijk alle notities</a>
		</p>
	</Section>

	<Section
		id="wie"
		title="wie zit erachter"
		intro="grondlaag werkt op het snijpunt van architectuurpraktijk, computerwetenschappen en data-architectuur."
	>
		<div class="about-text">
			<p>
				grondlaag is geen klassieke softwareconsultancy en ook geen klassiek architectuuradvies.
				het is een samenwerking tussen praktijkervaring in ontwerp en bouwcoördinatie,
				en technische expertise in computerwetenschappen en data-architectuur.
			</p>

			<p>
				die combinatie is belangrijk. veel digitale problemen in architectenbureaus zitten niet in één programma,
				maar in de verbinding tussen modellen, documenten, afspraken, bestekken, mappenstructuren en mensen.
				om die problemen goed op te lossen, moet je zowel de bouwpraktijk als de onderliggende informatiestructuur begrijpen.
			</p>

			<p>
				grondlaag gebruikt die dubbele blik om werkprocessen leesbaar, overdraagbaar en bruikbaar te maken:
				niet als abstract systeem, maar als concrete ondersteuning voor ontwerpteams die dagelijks met complexe projecten werken.
			</p>
		</div>
	</Section>

	<Section id="contact" title="contact">
		<p class="contact-line">
			loop je vast op digitale structuur, werkafspraken of tools? stuur een mail naar <a href="mailto:grondlaag@proton.me">grondlaag@proton.me</a> of <a href="https://cal.eu/grondlaag/snelle-babbel">boek een snelle babbel</a>.
		</p>
	</Section>
</main>
