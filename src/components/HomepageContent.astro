---
import { getCollection } from 'astro:content';
import ArticleCard from './ArticleCard.astro';
import Hero from './Hero.astro';
import PillarCard from './PillarCard.astro';
import Section from './Section.astro';
import { withBase } from '../utils/routes';

const pillars = [
	{
		title: '1. advies',
		description: 'gerichte hulp wanneer projectlogica te veel in hoofden, mappen, modellen, bestekken of spreadsheets zit.',
		href: withBase('advies'),
	},
	{
		title: '2. opleidingen',
		description: 'praktische sessies voor ontwerpteams die minder willen gokken in Revit, Excel, codering, documenten en digitale afspraken.',
		href: withBase('opleidingen'),
	},
	{
		title: '3. alaambak',
		description: 'geen platform, geen dashboard, geen belofte van totale controle. wel kleine formats, checks en tools voor plekken waar projecten beginnen lekken.',
		href: withBase('alaambak'),
	},
];

const latestPosts = (await getCollection('posts'))
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 3);
---

<main>
	<Hero
		title="grondlaag"
		subtitle="minder twijfel in mappen, modellen en meetstaten"
		text="grondlaag helpt kleine en middelgrote architecten- en ontwerpteams wanneer bestanden, BIM-logica, bestekken, spreadsheets en afspraken elk hun eigen waarheid beginnen vertellen."
		textSecond="geen nieuw systeem bovenop de chaos. eerst maken we de onderlaag leesbaar: wat staat waar, wie vertrouwt waarop, en welke informatie moet later nog kloppen?"
		ctaHref="mailto:grondlaag@proton.me"
		ctaLabel="toon waar het vastloopt"
		secondaryCtaHref="https://cal.eu/grondlaag/snelle-babbel"
		secondaryCtaLabel="boek een snelle babbel"
	/>

	<Section
		id="probleem"
		title="waar projecten digitaal beginnen lekken"
	>
		<div class="problem-text">
			<p>
				in veel ontwerpteams ontstaat digitale ruis niet door een gebrek aan inzet.
				het probleem is dat iedereen net anders ordent: een mapnaam, een Revit-parameter,
				een Excel-lijst, een besteknummer of een afspraak in een mail krijgt telkens een eigen kleine logica.
			</p>

			<p>
				zolang die logica privaat blijft, betaalt het team telkens opnieuw: zoeken, vragen,
				controleren, exporteren, hernoemen, herstellen. grondlaag vertrekt vanuit die dagelijkse twijfel,
				omdat daar de meeste digitale structuur echt verloren gaat.
			</p>
		</div>
	</Section>

	<Section
		id="aanpak"
		title="eerst de grondlaag"
		intro=""
	>
		<div class="problem-text">
			<p>
				we vertrekken niet vanuit één softwarepakket of één vaste methode.
				de vraag is eerst: welke informatie moet betrouwbaar blijven,
				wie moet ermee werken en wanneer moet iemand ze zonder uitleg kunnen begrijpen?
			</p>

			<p>
				pas daarna komen mappenstructuren, modelafspraken, besteklogica, spreadsheets,
				markdownbestanden, kleine webtools of automatisering in beeld.
				de tool volgt de structuur, niet omgekeerd.
			</p>

			<p>
				concreet kan dat betekenen dat we een team helpen om van zeven verschillende mappenstructuren naar één herkenbare projectstructuur te gaan.
				of dat we BIM-afspraken, besteknummers en meetstaatlogica beter op elkaar afstemmen, zodat informatie niet telkens opnieuw geïnterpreteerd moet worden.
			</p>
		</div>
	</Section>

	<Section
		id="pijlers"
		title="hoe we hier op ingrijpen"
		intro="grondlaag werkt op drie niveaus: directe hulp wanneer iets vastloopt, opleiding zodat teams hun eigen logica beter kunnen lezen, en kleine hulpmiddelen die structuur tastbaar maken."
	>
		<div class="pillar-grid">
			{pillars.map((pillar) => <PillarCard {...pillar} />)}
		</div>
	</Section>

	<Section
		id="notities"
		title="notities uit de praktijk"
		intro="korte teksten over digitale structuur, samenwerking, BIM, bestekken, kleine tools en de dagelijkse twijfel tussen ontwerpwerk en software."
	>
		<div class="article-teaser-list">
			{latestPosts.map((post) => (
				<ArticleCard
					title={post.data.title}
					description={post.data.description}
					href={withBase(`inzichten/${post.id}/`)}
					date={post.data.date}
				/>
			))}
		</div>
		<p class="section-link">
			<a href={withBase('inzichten')}>bekijk alle notities</a>
		</p>
	</Section>

	<Section
		id="wie"
		title="wie kijkt mee"
		intro="grondlaag werkt op het snijpunt van architectuurpraktijk, computerwetenschappen en data-architectuur."
	>
		<div class="about-text">
			<p>
				grondlaag is geen klassieke softwareconsultancy en ook geen klassiek architectuuradvies.
				het is een samenwerking tussen praktijkervaring in ontwerp en bouwcoördinatie,
				en technische expertise in computerwetenschappen en data-architectuur.
			</p>

			<p>
				die combinatie is belangrijk. veel digitale problemen in architectenbureaus zitten niet in één programma,
				maar in de verbinding tussen modellen, documenten, afspraken, bestekken, mappenstructuren en mensen.
				om die problemen goed op te lossen, moet je zowel de bouwpraktijk als de onderliggende informatiestructuur begrijpen.
			</p>

			<p>
				grondlaag gebruikt die dubbele blik om werkprocessen leesbaar, overdraagbaar en bruikbaar te maken:
				niet als abstract systeem, maar als concrete ondersteuning voor ontwerpteams die dagelijks met complexe projecten werken.
			</p>
		</div>
	</Section>

	<Section id="contact" title="contact">
		<p class="contact-line">
			loopt je projectlogica vast in mappen, modellen, meetstaten of afspraken? stuur een mail naar <a href="mailto:grondlaag@proton.me">grondlaag@proton.me</a> of <a href="https://cal.eu/grondlaag/snelle-babbel">boek een snelle babbel</a>.
		</p>
	</Section>
</main>
