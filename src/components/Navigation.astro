---
import { withBase } from '../utils/routes';

const links = [
	{ href: withBase(), label: 'home' },
	{ href: withBase('advies'), label: 'advies' },
	{ href: withBase('opleidingen'), label: 'opleidingen' },
	{ href: withBase('alaambak'), label: 'alaambak' },
	{ href: withBase('inzichten'), label: 'notities' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const homePath = withBase().replace(/\/$/, '') || '/';

const isLinkActive = (href: string) => {
	const normalizedHref = href.replace(/\/$/, '') || '/';

	if (normalizedHref === homePath) {
		return currentPath === homePath;
	}

	return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
};
---

<header class="site-nav">
	<div class="container site-nav__inner">
		<a class="site-nav__brand" href={withBase()}>grondlaag</a>
		<nav aria-label="hoofdnavigatie">
			<ul class="site-nav__list">
				{
					links.map((link) => {
						const isActive = isLinkActive(link.href);

						return (
							<li>
								<a
									class:list={['site-nav__link', { 'is-active': isActive }]}
									href={link.href}
									aria-current={isActive ? 'page' : undefined}
								>
									{link.label}
								</a>
							</li>
						);
					})
				}
			</ul>
		</nav>
	</div>
</header>
